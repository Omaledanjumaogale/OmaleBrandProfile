# ═══════════════════════════════════════════════════════════════
#  OmaleBrandProfile — Environment Variables
#  Copy this file to .env.local and fill in your real values.
#  NEVER commit .env.local to Git (it's in .gitignore).
# ═══════════════════════════════════════════════════════════════

# ── CONVEX ──────────────────────────────────────────────────────
# Get this from: https://dashboard.convex.dev → your project → Settings
# Run `npx convex dev` once to auto-generate .env.local with this value.
PUBLIC_CONVEX_URL=https://your-project-slug.convex.cloud

# ── FIREBASE AUTH ───────────────────────────────────────────────
# Get all values from: Firebase Console → Project Settings → Your apps → Web app
# https://console.firebase.google.com
PUBLIC_FIREBASE_API_KEY=AIzaSy...
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project-id
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
PUBLIC_FIREBASE_APP_ID=1:000000000000:web:000000000000000000

# ── RESEND (Email sending — Convex backend only) ─────────────────
# Get from: https://resend.com/api-keys
# Add this to Convex environment, NOT here:
#   npx convex env set RESEND_API_KEY re_xxxxxxxxxxxxxxxxxxxxx
# Or: Convex Dashboard → Settings → Environment Variables
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx  ← goes in Convex, not here

# ── SETUP INSTRUCTIONS ───────────────────────────────────────────
# 1. Copy this file:   cp .env.local.example .env.local
# 2. Fill in values above
# 3. Start Convex dev: npx convex dev   (keep running in a terminal)
# 4. Start SvelteKit:  pnpm dev         (in a second terminal)
#
# For production (Cloudflare Pages):
#   Add PUBLIC_CONVEX_URL + all PUBLIC_FIREBASE_* to:
#   Cloudflare Pages → Settings → Environment Variables
#
#   Add RESEND_API_KEY to Convex dashboard environment variables.
